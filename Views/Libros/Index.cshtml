@model IEnumerable<GestorTareas.Models.LibroRenta>

@{
    ViewData["Title"] = "BiblioBeat Lounge - Renta de Libros & Música";
    var generos = ViewBag.Generos as List<string> ?? new List<string>();
    var disponibles = Model.Count(l => !l.Rentado);
    var rentados = Model.Count(l => l.Rentado);
}

<!-- ALERTA DE MENSAJES -->
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SECCIÓN LOUNGE MUSICAL (AUDIO PLAYER PARA LECTURA) -->
<div class="card border-0 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #2b1055 0%, #7597de 100%); border-radius: 18px;">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-3 mb-lg-0">
                <span class="badge bg-light text-dark mb-2 px-3 py-2 fw-semibold">🎧 Zona de Lectura & Sonido</span>
                <h2 class="fw-bold mb-1">BiblioBeat Music Lounge</h2>
                <p class="mb-0 text-white-50">Selecciona música ambiental relajante para leer y alquila tu libro favorito en el mismo lugar.</p>
            </div>
            <div class="col-lg-6">
                <div class="bg-dark bg-opacity-50 p-3 rounded-4 shadow-inner">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <small class="text-white-50 text-uppercase d-block" style="font-size: 0.75rem;">Reproduciendo ahora</small>
                            <span id="currentTrackTitle" class="fw-bold text-warning">✨ Piano Suave & Acordes Relajantes</span>
                        </div>
                        <div class="d-flex gap-1 align-items-end" style="height: 24px;" id="visualizer">
                            <span class="bg-warning rounded" style="width: 4px; height: 10px; animation: bounce 0.8s infinite alternate;"></span>
                            <span class="bg-warning rounded" style="width: 4px; height: 18px; animation: bounce 0.6s infinite alternate 0.2s;"></span>
                            <span class="bg-warning rounded" style="width: 4px; height: 24px; animation: bounce 0.7s infinite alternate 0.4s;"></span>
                            <span class="bg-warning rounded" style="width: 4px; height: 14px; animation: bounce 0.5s infinite alternate 0.1s;"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <button id="btnPlayPause" class="btn btn-warning rounded-circle shadow px-3 py-2" onclick="togglePlayMusic()">
                            <span id="iconPlay">▶ Escuchar</span>
                        </button>

                        <div class="flex-grow-1">
                            <select id="ambientSelect" class="form-select form-select-sm bg-secondary text-white border-0" onchange="changeTrack(this.value)">
                                <option value="piano">🎹 Piano Clásico para Lectura</option>
                                <option value="lofi">☕ Lo-Fi Chill Beats & Café</option>
                                <option value="rain">🌧️ Lluvia Suave y Chimenea</option>
                                <option value="ambient">🌌 Espacio Zen & Meditación</option>
                            </select>
                        </div>

                        <div class="d-flex align-items-center gap-1" style="min-width: 110px;">
                            <span style="font-size: 0.8rem;">🔊</span>
                            <input type="range" id="volumeControl" class="form-range" min="0" max="1" step="0.05" value="0.5" oninput="setVolume(this.value)">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BARRA DE ESTADÍSTICAS Y ACCIONES -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 bg-primary bg-opacity-10 text-primary p-3 rounded-4 shadow-sm h-100">
            <h6 class="text-muted mb-1">Total Catálogo</h6>
            <h3 class="fw-bold mb-0">@Model.Count() <small class="fs-6 text-muted">libros</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 bg-success bg-opacity-10 text-success p-3 rounded-4 shadow-sm h-100">
            <h6 class="text-muted mb-1">Disponibles</h6>
            <h3 class="fw-bold mb-0">@disponibles <small class="fs-6 text-muted">listos para rentar</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 bg-warning bg-opacity-10 text-warning p-3 rounded-4 shadow-sm h-100">
            <h6 class="text-muted mb-1">En Préstamo</h6>
            <h3 class="fw-bold mb-0">@rentados <small class="fs-6 text-muted">rentados</small></h3>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 bg-secondary bg-opacity-10 p-3 rounded-4 shadow-sm h-100 d-flex justify-content-center">
            <button class="btn btn-outline-primary rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#modalNuevoLibro">
                + Añadir Libro
            </button>
        </div>
    </div>
</div>

<!-- FILTROS Y BÚSQUEDA -->
<div class="card border-0 shadow-sm p-3 mb-4 rounded-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" name="buscar" value="@ViewBag.BuscarActual" class="form-control border-start-0" placeholder="Buscar por título o autor...">
            </div>
        </div>
        <div class="col-md-4">
            <select name="genero" class="form-select" onchange="this.form.submit()">
                <option value="Todos" selected="@(ViewBag.GeneroActual == "Todos")">Todos los Géneros</option>
                @foreach (var g in generos)
                {
                    <option value="@g" selected="@(ViewBag.GeneroActual == g)">@g</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 rounded-pill">Filtrar</button>
            @if (!string.IsNullOrEmpty(ViewBag.BuscarActual) || ViewBag.GeneroActual != "Todos")
            {
                <a asp-action="Index" class="btn btn-light rounded-pill">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- GRID DE LIBROS PARA RENTAR -->
<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <p class="fs-4 text-muted">No se encontraron libros con los criterios seleccionados.</p>
            <a asp-action="Index" class="btn btn-outline-primary">Ver todos los libros</a>
        </div>
    }
    else
    {
        @foreach (var libro in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                    <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center @(libro.Rentado ? "bg-warning bg-opacity-25" : "bg-light")">
                        <span class="badge @(libro.Rentado ? "bg-warning text-dark" : "bg-success") px-3 py-2 rounded-pill">
                            @(libro.Rentado ? "📖 Rentado" : "✅ Disponible")
                        </span>
                        <span class="text-muted small fw-semibold"><i class="bi bi-tag"></i> @libro.Genero</span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                 style="width: 52px; height: 68px; background: @(libro.Rentado ? "#6c757d" : "#4e54c8"); font-size: 1.5rem;">
                                📖
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">@libro.Titulo</h5>
                                <p class="text-muted mb-0 small">por <span class="text-dark fw-semibold">@libro.Autor</span></p>
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            @if (libro.Rentado)
                            {
                                <div class="bg-light p-2 rounded-3 mb-3 small">
                                    <div class="text-muted">Rentado por: <strong>@libro.RentadoPor</strong></div>
                                    <div class="text-danger">Devolución: <strong>@(libro.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                                </div>
                                <form asp-action="Devolver" asp-route-id="@libro.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">
                                        Devolver libro a la biblioteca
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary w-100 rounded-pill shadow-sm" 
                                        onclick="abrirModalRenta(@libro.Id, '@libro.Titulo')">
                                    Rentar por 7 días
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- MODAL PARA RENTAR LIBRO -->
<div class="modal fade" id="modalRentar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Rentar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rentarLibroId" name="id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Rentar libro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-3">Estás a punto de rentar: <strong id="rentarTitulo" class="text-dark"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tu nombre / Lector:</label>
                        <input type="text" name="rentadoPor" class="form-control" placeholder="Ej. Juan Pérez" required autofocus />
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        📅 Plazo de renta estándar: <strong>7 días a partir de hoy</strong>.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Confirmar Renta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL PARA NUEVO LIBRO -->
<div class="modal fade" id="modalNuevoLibro" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Añadir nuevo libro al catálogo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Título</label>
                        <input type="text" name="Titulo" class="form-control" required placeholder="Título del libro" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Autor</label>
                        <input type="text" name="Autor" class="form-control" required placeholder="Nombre del autor" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Género</label>
                        <input type="text" name="Genero" class="form-control" required placeholder="Ej. Novela, Ciencia Ficción, Historia..." />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Guardar Libro</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT DEL REPRODUCTOR AMBIENTAL Y CONTROLES -->
<script>
    // Motor de sonido ambiental Web Audio API para funcionar 100% offline y garantizado
    let audioCtx = null;
    let isPlaying = false;
    let mainGain = null;
    let ambientInterval = null;
    let rainNoiseNode = null;

    const tracksInfo = {
        piano: { title: "🎹 Piano Clásico para Lectura", notes: [261.63, 329.63, 392.00, 523.25, 440.00, 349.23, 293.66], wave: "sine", tempo: 2200 },
        lofi: { title: "☕ Lo-Fi Chill Beats & Café", notes: [196.00, 246.94, 293.66, 369.99, 440.00, 329.63], wave: "triangle", tempo: 1500 },
        rain: { title: "🌧️ Lluvia Suave y Chimenea", notes: [174.61, 220.00, 261.63, 329.63], wave: "sine", tempo: 3000, hasRain: true },
        ambient: { title: "🌌 Espacio Zen & Meditación", notes: [130.81, 164.81, 196.00, 246.94, 293.66], wave: "sine", tempo: 3500 }
    };

    let currentPreset = "piano";

    function initAudio() {
        if (!audioCtx) {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContext();
            mainGain = audioCtx.createGain();
            mainGain.gain.value = parseFloat(document.getElementById('volumeControl').value);
            mainGain.connect(audioCtx.destination);
        }
    }

    function playNote(freq, type, duration) {
        if (!isPlaying || !audioCtx) return;
        const osc = audioCtx.createOscillator();
        const noteGain = audioCtx.createGain();

        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

        noteGain.gain.setValueAtTime(0, audioCtx.currentTime);
        noteGain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.3);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

        osc.connect(noteGain);
        noteGain.connect(mainGain);

        osc.start();
        osc.stop(audioCtx.currentTime + duration);
    }

    function startMusicEngine() {
        const preset = tracksInfo[currentPreset];
        document.getElementById('currentTrackTitle').innerText = preset.title;

        if (ambientInterval) clearInterval(ambientInterval);

        function tick() {
            if (!isPlaying) return;
            const note = preset.notes[Math.floor(Math.random() * preset.notes.length)];
            const note2 = preset.notes[Math.floor(Math.random() * preset.notes.length)];
            playNote(note, preset.wave, 3.5);
            setTimeout(() => {
                if (isPlaying) playNote(note2 * 1.5, preset.wave, 4.0);
            }, 600);
        }

        tick();
        ambientInterval = setInterval(tick, preset.tempo);
    }

    function togglePlayMusic() {
        initAudio();
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }

        isPlaying = !isPlaying;
        const btn = document.getElementById('btnPlayPause');
        const icon = document.getElementById('iconPlay');
        const visualizer = document.getElementById('visualizer');

        if (isPlaying) {
            btn.classList.remove('btn-warning');
            btn.classList.add('btn-light');
            icon.innerText = "⏸ Pausar";
            startMusicEngine();
            visualizer.style.display = 'flex';
        } else {
            btn.classList.remove('btn-light');
            btn.classList.add('btn-warning');
            icon.innerText = "▶ Escuchar";
            if (ambientInterval) clearInterval(ambientInterval);
            visualizer.style.display = 'none';
        }
    }

    function changeTrack(value) {
        currentPreset = value;
        if (isPlaying) {
            startMusicEngine();
        } else {
            document.getElementById('currentTrackTitle').innerText = tracksInfo[value].title;
        }
    }

    function setVolume(val) {
        if (mainGain) {
            mainGain.gain.value = parseFloat(val);
        }
    }

    function abrirModalRenta(id, titulo) {
        document.getElementById('rentarLibroId').value = id;
        document.getElementById('rentarTitulo').innerText = titulo;
        new bootstrap.Modal(document.getElementById('modalRentar')).show();
    }
</script>

<style>
    keyframes bounce {
        0% { height: 6px; }
        100% { height: 24px; }
    }
</style>
