@model IEnumerable<GestorTareas.Models.Tarea>

@{
    ViewData["Title"] = "Listado de Tareas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">📝 Gestión de Tareas</h2>
        <p class="text-muted mb-0">
            Sesión iniciada como: 
            <strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</strong> 
            (@(User.IsInRole("Administrador") ? "👑 Administrador" : "👤 Usuario"))
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">+ Nueva tarea</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Título</th>
                    <th>Descripción</th>
                    <th>Fecha Límite</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">No hay tareas registradas en este momento.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.Titulo</td>
                        <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                        <td>@(item.FechaLimite.HasValue ? item.FechaLimite.Value.ToString("dd/MM/yyyy") : "-")</td>
                        <td>
                            @if (item.Completada)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">✓ Completada</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">⏳ Pendiente</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                @if (!item.Completada)
                                {
                                    <form asp-action="Completar" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Completar</button>
                                    </form>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('¿Está seguro de eliminar esta tarea?');">
                                            Eliminar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
