@model GestorTareas.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="fs-1">🔐</span>
                    <h2 class="fw-bold mt-2">Iniciar Sesión</h2>
                    <p class="text-muted small">Ingresa con tu cuenta de Administrador o Usuario</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold">Nombre de Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">👤</span>
                            <input asp-for="Username" id="inputUsername" class="form-control" placeholder="Ej. admin o usuario" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">🔑</span>
                            <input asp-for="Password" id="inputPassword" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Mantener la sesión iniciada</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
                        Ingresar a la Plataforma
                    </button>
                </form>

                <div class="text-center">
                    <span class="text-muted small">¿No tienes cuenta? </span>
                    <a asp-action="Registro" class="fw-semibold text-decoration-none">Regístrate aquí</a>
                </div>

                <!-- Tarjetas de acceso rápido para demostración -->
                <div class="mt-4 pt-3 border-top">
                    <p class="text-muted small text-center mb-2 fw-semibold">⚡ Accesos de Demostración:</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger w-50 rounded-pill" onclick="llenarCredenciales('admin', 'Admin123!')">
                            👑 Admin: <strong>admin</strong>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary w-50 rounded-pill" onclick="llenarCredenciales('usuario', 'User123!')">
                            👤 Usuario: <strong>usuario</strong>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function llenarCredenciales(user, pass) {
            document.getElementById('inputUsername').value = user;
            document.getElementById('inputPassword').value = pass;
        }
    </script>
}
